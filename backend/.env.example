# Copy to backend/.env (never commit .env).

# ── Supabase Postgres ────────────────────────────────────────────────
# Supabase dashboard → your project → "Connect" button → "Session pooler" → URI.
# Looks like: postgresql://postgres.<project-ref>:<db-password>@aws-0-<region>.pooler.supabase.com:5432/postgres
# Replace [YOUR-PASSWORD] with your database password (URL-encode special characters like @ # / %).
DATABASE_URL=

# "require" for Supabase (TLS on). Set to "disable" only for a local Postgres without TLS.
DATABASE_SSL=require
# Optional: path to Supabase's CA certificate (Database settings → SSL → Download certificate)
# to fully verify the server. Without it the connection is still encrypted, but not CA-verified.
DATABASE_CA_CERT=

# ── Auth ─────────────────────────────────────────────────────────────
# Long random string used to sign login tokens. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d

# ── Server ───────────────────────────────────────────────────────────
PORT=4000
# Comma-separated browser origins allowed to call the API directly (not needed in dev — Vite proxies /api).
CORS_ORIGIN=http://localhost:5173

# Shipping rules (must match frontend/src/config/site.js).
FREE_SHIPPING_THRESHOLD=2999
SHIPPING_FEE=99
