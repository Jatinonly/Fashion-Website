# Copy to frontend/.env (never commit .env).

# Used only by mock checkout. Real checkout uses the keyId returned by the backend.
VITE_RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx

# Where the API lives. "/api" goes through the Vite dev proxy to the backend (see vite.config.js).
# Leave empty to keep using the in-browser mock services (no backend needed).
VITE_API_BASE_URL=/api

# Backend address the dev proxy forwards /api to.
API_PROXY_TARGET=http://localhost:4000
